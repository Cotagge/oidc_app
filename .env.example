# Keycloak / IdP URL a realm
REACT_APP_KEYCLOAK_URL=https://your-keycloak-server.com
REACT_APP_KEYCLOAK_REALM=your-realm

# Popisek prostředí (zobrazuje se u loga, např. DEV / TEST / PROD)
REACT_APP_KEYCLOAK_ENV=DEV

# OIDC klienti (Authorization Code + PKCE)
REACT_APP_KEYCLOAK_CLIENT_ID_1F=your-oidc-client-1fa
REACT_APP_KEYCLOAK_CLIENT_ID_2F=your-oidc-client-2fa
REACT_APP_KEYCLOAK_CLIENT_ID_3F=your-oidc-client-3fa

# SAML klienti (HTTP Redirect Binding, SP-initiated)
REACT_APP_KEYCLOAK_SAML_CLIENT_ID_1F=your-saml-client-1fa
REACT_APP_KEYCLOAK_SAML_CLIENT_ID_2F=your-saml-client-2fa
REACT_APP_KEYCLOAK_SAML_CLIENT_ID_3F=your-saml-client-3fa
